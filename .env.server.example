# Backend config. Copy to .env.server (gitignored) and fill in.
#   cp .env.server.example .env.server
#
# Nothing in this file ever reaches the browser: it is read by the backend
# container only. That is precisely why the OpenRouter key moved here.

# --- GitHub repo (admin login + profile commits) -----------------------------
# owner/name of the repo this site deploys from; profile commits target it.
GITHUB_REPO=your-handle/portfolio
GITHUB_BRANCH=main
PROFILE_PATH=src/content/profile.json
#
# Admin login is ONE password. Type it at /#/admin; the server answers with a signed
# session token that lives in the browser tab. The GitHub token below never reaches
# any browser, so this password is the only admin secret to remember. Make it long.
ADMIN_PASSWORD=
# Optional key for signing session tokens. Blank = derived from ADMIN_PASSWORD, so
# changing the password signs every session out.
SESSION_SECRET=
# How long a login session stays valid, in hours (default one week).
SESSION_TTL_HOURS=168
#
# The commit credential for profile.json, held server-side only. A fine-grained PAT:
#   Repository access  → only this repo
#   Repository permissions → Contents: Read and write
# Create it at github.com/settings/personal-access-tokens.
GITHUB_TOKEN=

# --- Vercel Blob (comments + avatar) -----------------------------------------
# Read-write token for the Blob store; `vercel env pull` writes it. Local dev uses
# the same store as the deployed site. Blank = comments and avatar upload disabled.
BLOB_READ_WRITE_TOKEN=

# --- OpenRouter (optional) ---------------------------------------------------
# Leave the key blank and chat still works — it answers with raw retrieval plus
# citations instead of calling the model.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
# Give up on a model call after this long (ms); chat then shows raw retrieval.
OPENROUTER_TIMEOUT_MS=30000

# --- Server ------------------------------------------------------------------
PORT=8787
# Exact origin the static site is served from. No trailing slash, must match or
# the browser will block every request.
FRONTEND_ORIGIN=http://localhost:5173
# Only "1" when a reverse proxy you control is the only path in. Also decides the
# scheme used for stored avatar URLs, so it must be correct in production.
TRUST_PROXY=0

# --- Optional Caddy TLS ------------------------------------------------------
# Only needed to serve the API over https. Leave blank unless you start the stack
# with `docker compose --profile tls up -d`.
CADDY_DOMAIN=

# --- Abuse limits ------------------------------------------------------------
# Comments are open to anonymous visitors, so these are the only thing standing
# between the store and a spam bot.
COMMENT_MAX_LENGTH=2000
NAME_MAX_LENGTH=40
COMMENTS_PER_WINDOW=5
REACTIONS_PER_WINDOW=60
CHAT_PER_WINDOW=20
# Caps how often one address can guess the admin password.
AUTH_PER_WINDOW=30
AVATAR_MAX_BYTES=2097152
RATE_WINDOW_MS=600000
