# Frontend config. Copy to .env (gitignored) and fill in.
#
# Vite inlines every VITE_* variable into the built JavaScript, so this file must
# only ever hold PUBLIC values. The OpenRouter key, MinIO credentials and GitHub
# client secret live in .env.server, behind the backend.

# Base URL of the backend. Either a full origin or "/" for same-origin, which is
# what the Vercel deployment in vercel.json uses: the backend runs as a service in
# the same project, so requests go to /api/* on whatever host served the page.
# With the whole line unset the site still builds and runs, but comments and the
# admin login show a "not configured" note.
VITE_API_BASE_URL=http://localhost:8787
# VITE_API_BASE_URL=/
