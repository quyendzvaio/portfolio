# Frontend config. Copy to .env (gitignored) and fill in.
#
# Vite inlines every VITE_* variable into the built JavaScript, so this file must
# only ever hold PUBLIC values. The OpenRouter key, MinIO credentials and GitHub
# client secret live in .env.server, behind the backend.

# Base URL of the backend (see docker-compose.yml). With it unset the site still
# builds and runs, but comments and the admin login show a "not configured" note.
VITE_API_BASE_URL=http://localhost:8787
